# Copy file này thành .env rồi điền thông tin thật vào
# cp .env.example .env

# AWS
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Tên 2 bucket trên S3
BUCKET_A_NAME=ten-bucket-a-cua-nhom
BUCKET_B_NAME=ten-bucket-b-cua-nhom

# Server
PORT=3000
FRONTEND_URL=http://127.0.0.1:5500
